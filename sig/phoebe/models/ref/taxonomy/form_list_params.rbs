module Phoebe
  module Models
    module Ref
      module Taxonomy
        type form_list_params =
          { species_code: String } & Phoebe::Internal::Type::request_parameters

        class FormListParams < Phoebe::Internal::Type::BaseModel
          extend Phoebe::Internal::Type::RequestParameters::Converter
          include Phoebe::Internal::Type::RequestParameters

          attr_accessor species_code: String

          def initialize: (
            species_code: String,
            ?request_options: Phoebe::request_opts
          ) -> void

          def to_hash: -> {
            species_code: String,
            request_options: Phoebe::RequestOptions
          }
        end
      end
    end
  end
end
