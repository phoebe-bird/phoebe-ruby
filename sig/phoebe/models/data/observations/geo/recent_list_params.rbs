              back: Integer,
              cat: Phoebe::Models::Data::Observations::Geo::RecentListParams::cat,
              dist: Integer,
              hotspot: bool,
              include_provisional: bool,
              max_results: Integer,
              sort: Phoebe::Models::Data::Observations::Geo::RecentListParams::sort,
              spp_locale: String
            }
            & Phoebe::Internal::Type::request_parameters

          class RecentListParams < Phoebe::Internal::Type::BaseModel
            extend Phoebe::Internal::Type::RequestParameters::Converter
            include Phoebe::Internal::Type::RequestParameters

            attr_accessor lat: Float

            attr_accessor lng: Float

            attr_reader back: Integer?

            def back=: (Integer) -> Integer

            attr_reader cat: Phoebe::Models::Data::Observations::Geo::RecentListParams::cat?

            def cat=: (
              Phoebe::Models::Data::Observations::Geo::RecentListParams::cat
            ) -> Phoebe::Models::Data::Observations::Geo::RecentListParams::cat

            attr_reader dist: Integer?

            def dist=: (Integer) -> Integer

            attr_reader hotspot: bool?

