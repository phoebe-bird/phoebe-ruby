            ) -> Phoebe::Models::Data::Observations::Geo::RecentListParams::sort

            attr_reader spp_locale: String?

            def spp_locale=: (String) -> String

            def initialize: (
              lat: Float,
              lng: Float,
              ?back: Integer,
              ?cat: Phoebe::Models::Data::Observations::Geo::RecentListParams::cat,
              ?dist: Integer,
              ?hotspot: bool,
              ?include_provisional: bool,
