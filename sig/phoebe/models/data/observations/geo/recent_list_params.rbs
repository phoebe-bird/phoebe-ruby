              ?sort: Phoebe::Models::Data::Observations::Geo::RecentListParams::sort,
              ?spp_locale: String,
              ?request_options: Phoebe::request_opts
            ) -> void

            type cat =
              :species
              | :slash
              | :issf
              | :spuh
              | :hybrid
              | :domestic
              | :form
              | :intergrade

            module Cat
              extend Phoebe::Internal::Type::Enum

              SPECIES: :species
              SLASH: :slash
              ISSF: :issf
              SPUH: :spuh
              HYBRID: :hybrid
              DOMESTIC: :domestic
              FORM: :form
              INTERGRADE: :intergrade

              def self?.values: -> ::Array[Phoebe::Models::Data::Observations::Geo::RecentListParams::cat]
            end

            type sort = :date | :species

            module Sort
              extend Phoebe::Internal::Type::Enum

