            attr_reader include_provisional: bool?

            def include_provisional=: (bool) -> bool

            attr_reader max_results: Integer?

            def max_results=: (Integer) -> Integer

            attr_reader sort: Phoebe::Models::Data::Observations::Geo::RecentListParams::sort?

            def sort=: (
