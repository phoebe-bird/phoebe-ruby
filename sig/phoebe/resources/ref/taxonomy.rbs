module Phoebe
  module Resources
    class Ref
      class Taxonomy
        attr_reader ebird: Phoebe::Resources::Ref::Taxonomy::Ebird

        attr_reader forms: Phoebe::Resources::Ref::Taxonomy::Forms

        attr_reader locales: Phoebe::Resources::Ref::Taxonomy::Locales

        attr_reader versions: Phoebe::Resources::Ref::Taxonomy::Versions

        attr_reader species_groups: Phoebe::Resources::Ref::Taxonomy::SpeciesGroups

        def initialize: (client: Phoebe::Client) -> void
      end
    end
  end
end
